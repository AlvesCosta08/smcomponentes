# ============================================================
# MERCADO PAGO
# ============================================================

# 🔥 ATENÇÃO: Para produção, substitua pelos valores reais
# 🔥 Para testes, mantenha como está (modo MOCK)

# Chaves de API
MERCADOPAGO_ACCESS_TOKEN=APP_USR-1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL do Webhook (atualize com sua URL real)
MERCADOPAGO_WEBHOOK_URL=https://seudominio.com/api/webhooks/mercadopago

# 🔥 Configurações de Ambiente
MERCADOPAGO_MOCK=true
MERCADOPAGO_ENV=local
MERCADOPAGO_DEBUG=true

# 🔥 MODO MOCK: 
# - true = usa dados falsos (desenvolvimento local)
# - false = usa API real (produção)

# 🔥 AMBIENTE:
# - local = desenvolvimento local
# - sandbox = testes no Mercado Pago
# - production = produção real

# IDs para integração OAuth (opcional)
MERCADOPAGO_CLIENT_ID=1234567890
MERCADOPAGO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Descritor da loja (aparece na fatura do cliente)
MERCADOPAGO_STATEMENT_DESCRIPTOR=SM Componentes