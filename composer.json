{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "Sistema de gerenciamento de produtos e componentes.",
    "keywords": [
        "laravel",
        "framework",
        "ecommerce",
        "produtos",
        "estoque"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "intervention/image": "^4.2",
        "intervention/image-laravel": "^4.1",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.16",
        "livewire/livewire": "^4.4",
        "mercadopago/dx-php": "^3.14",
        "rap2hpoutre/fast-excel": "^5.14",
        "spatie/laravel-backup": "^9.0",
        "spatie/laravel-permission": "^6.25",
        "symfony/http-client": "^7.0",
        "symfony/mailer": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.66",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/league/flysystem/src/Local/",
            "vendor/laravel/pint/app/Providers/"
        ],
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Unit/"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": [
            "@php artisan test"
        ],
        "test:coverage": [
            "@php artisan test --coverage"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:fix": [
            "@php vendor/bin/pint --fix"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": false
        },
        "platform-check": true,
        "process-timeout": 3600
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://repo.packagist.org"
        }
    }
}